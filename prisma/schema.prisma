// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  passwordHash String?
  emailVerified DateTime? // preuve de propriété de la boîte mail (lien cliqué) — login CLIENT bloqué tant que null
  role      String    @default("CLIENT") // "ADMIN" or "CLIENT"
  createdAt DateTime  @default(now())

  projects  Project[]
  messages  Message[]
  magicLinkTokens MagicLinkToken[]

  @@index([role, createdAt])
  @@index([createdAt])
}

model MagicLinkToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  purpose    String   @default("PASSWORD_SET") // "PASSWORD_SET" ou "EMAIL_VERIFY" — un token n'est valable que pour l'usage prévu
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id               String     @id @default(cuid())
  clientId         String
  name             String
  status           String     @default("ACTIVE") // "ACTIVE", "COMPLETED", "ON_HOLD", "CANCELLED"
  estimatedDelivery DateTime?
  liveUrl          String?    // URL du site/outil livré une fois en ligne — affiche le CTA "Voir mon site" côté client
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // Origine commande (site public) — permet la vue financière réelle
  externalOrderId  String?    @unique // ex: ord_1234567890_abcdef (data/orders/*.json côté site)
  sector           String?    // coiffure, artisan, horeca, praticien...
  totalPrice       Float?     // prix total HTVA du pack/service
  depositAmount    Float?     // acompte encaissé (Mollie, one-shot)
  remainingAmount  Float?     // solde dû à la livraison (encaissé manuellement)
  monthlyAmount    Float?     // suivi mensuel récurrent

  client           User       @relation(fields: [clientId], references: [id])
  stages           Stage[]
  messages         Message[]
  documents        Document[]
  payments         Payment[]
  events           Event[]
  invoices         Invoice[]

  @@index([clientId])
  @@index([status, updatedAt])
  @@index([updatedAt])
}

model Stage {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      String    @default("PENDING") // "PENDING", "IN_PROGRESS", "WAITING_CLIENT", "BLOCKED", "REVIEW", "COMPLETED"
  orderIndex  Int
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id])
  messages    Message[]

  @@index([projectId, orderIndex])
  @@index([updatedAt])
}

model Message {
  id        String   @id @default(cuid())
  projectId String?
  stageId   String?
  authorId  String
  content   String
  createdAt DateTime @default(now())

  project   Project? @relation(fields: [projectId], references: [id])
  stage     Stage?   @relation(fields: [stageId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])

  @@index([projectId, createdAt])
  @@index([stageId])
  @@index([authorId])
}

model Document {
  id         String   @id @default(cuid())
  projectId  String
  type       String   // "INVOICE", "ASSET", "CONTRACT"
  url        String
  filename   String
  filesize   Int
  mimeType   String
  uploadedBy String
  uploadedAt DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id])

  @@index([projectId, uploadedAt])
  @@index([uploadedAt])
}

model Payment {
  id                String   @id @default(cuid())
  projectId         String
  amount            Float
  status            String   @default("PENDING") // "PENDING", "PAID", "CANCELLED"
  type              String   // "DEPOSIT", "BALANCE", "QUOTE", "INVOICE", "PAYMENT"
  createdAt         DateTime @default(now())

  // Mollie — providerPaymentId est l'identifiant Mollie ("tr_xxx"), utilisé
  // par le webhook pour retrouver ce Payment. checkoutUrl est l'URL de
  // paiement hébergée renvoyée à la création, affichée au client tant que
  // le paiement n'est pas confirmé.
  provider          String?  // "MOLLIE"
  providerPaymentId String?  @unique
  checkoutUrl       String?

  project   Project  @relation(fields: [projectId], references: [id])
  invoice   Invoice?

  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

// Commandes du site public (purity-agency-site, Render) — persistées ici
// car le service Render tourne sans disque (plan gratuit, confirmé via
// l'API Render le 2026-08-05) : un stockage fichier local y est effacé à
// chaque redéploiement/restart. Le site lit/écrit ces lignes via
// /api/internal/orders au lieu d'un fichier JSON. `id` reprend l'id "ord_..."
// généré côté site, jamais régénéré ici.
model Order {
  id                   String    @id // "ord_<timestamp>_<hex>", généré côté site
  status               String    @default("pending") // "pending", "paid"
  sector               String?
  pack                 String?
  name                 String?
  price                Float?
  deposit              Float?
  remaining            Float?
  monthly              Float?
  clientName           String?
  company              String?
  bce                  String?
  email                String?
  phone                String?
  paymentMode          String?
  options              Json?
  intake               Json?
  brief                Json?

  molliePaymentId      String?   @unique
  mollieCustomerId     String?
  mollieSubscriptionId String?
  dashboardUrl         String?

  // Idempotence webhook — voir handleMollieWebhook côté site : une livraison
  // dupliquée par Mollie ne doit pas redéclencher provisioning/emails tant
  // que la précédente est en cours (fenêtre de fraîcheur de 10 min).
  webhookProcessingAt  DateTime?
  paidAt               DateTime?

  provisioningStatus   String?
  provisionedAt        DateTime?
  provisioningError    String?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([mollieSubscriptionId])
  @@index([status, createdAt])
}

// Boîte de réception unifiée pour tout ce qui arrive du site public :
// question/lead (formulaire ou chatbot OctoMask), prise de RDV, commande payée.
// Les commandes créent aussi un Project (voir /api/internal/provision) — l'Event
// associé sert uniquement au fil d'activité, pas de duplication de données métier.
model Event {
  id        String    @id @default(cuid())
  type      String    // "LEAD", "BOOKING", "ORDER"
  status    String    @default("NEW") // "NEW", "SEEN", "DONE"
  name      String?
  email     String?
  phone     String?
  company   String?
  summary   String?   // ligne courte : besoin exprimé, pack commandé, créneau réservé...
  payload   Json?     // détail brut (need, entreprise, créneau, référence commande...)
  createdAt DateTime  @default(now())
  seenAt    DateTime?

  // Rattachement une fois la demande convertie en client/projet — permet de
  // remonter d'une fiche client vers la demande d'origine, et inversement.
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id])

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
  @@index([email])
  @@index([projectId])
}

// ==========================================
// PÔLE 01 : ACQUISITION (CRM & Automation)
// ==========================================

model Mission {
  id          String   @id @default(cuid())
  name        String   // ex: "BTP Wallonie Q3"
  parameters  Json     // { sectors: [], locations: [], maxLeads: 50 }
  status      String   @default("ACTIVE") // ACTIVE, COMPLETED, PAUSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads       Lead[]

  @@index([status, createdAt])
}

model Lead {
  id          String   @id @default(cuid())
  missionId   String
  companyName String
  websiteUrl  String?
  googleMapsUrl String?
  location    String?
  source      String   // EXA, GOOGLE_PLACES, LINKEDIN
  status      String   @default("NEW") // NEW, ENRICHED, DRAFTED, CONTACTED, BOUNCED, REPLIED, MEETING_BOOKED
  
  // Données d'enrichissement (Intelligence Analyst)
  contactName  String?
  contactEmail String?
  contactRole  String?
  auditData    Json?   // Lighthouse score, pain points, etc.

  // Score déterministe du Lead Scoring Analyst (0-100) — nullable : un lead
  // pas encore scoré n'est pas un lead à zéro, c'est un lead sans donnée.
  // Voir ai/01_ACQUISITION/Lead_Scoring_Analyst/README.md pour la méthode.
  score       Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mission     Mission  @relation(fields: [missionId], references: [id])
  emailDrafts EmailDraft[]

  @@index([missionId, status])
  @@index([status, updatedAt])
  @@index([score])
}

model EmailDraft {
  id        String   @id @default(cuid())
  leadId    String
  subject   String
  bodyHtml  String   @db.Text
  tone      String
  status    String   @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED, SENT
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, status])
  @@index([status, createdAt])
}

// ==========================================
// PÔLE 04 : FINANCE (Facturation)
// ==========================================

// Purity Agency est sous régime de la franchise de taxe (art. 56bis CTVA) —
// TVA non applicable sur ses propres factures, mention légale obligatoire
// en lieu et place d'un taux. Transmission Peppol (obligatoire B2B en
// Belgique depuis le 2026-01-01) nécessite un point d'accès certifié
// (Billit, Exact Online...) — pas encore souscrit, voir InvoiceAgent.ts.
model Invoice {
  id            String    @id @default(cuid())
  projectId     String
  paymentId     String?   @unique
  invoiceNumber String    @unique // séquentiel par année, ex: 2026-0001
  clientName    String
  clientEmail   String
  lineItems     Json      // [{ description, quantity, unitPrice, total }]
  totalAmount   Float
  legalMention  String    // mention légale réelle (franchise ou taux), jamais inventée
  status        String    @default("DRAFT") // DRAFT, ISSUED, PAID
  issuedAt      DateTime?
  createdAt     DateTime  @default(now())

  project       Project   @relation(fields: [projectId], references: [id])
  payment       Payment?  @relation(fields: [paymentId], references: [id])

  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

// ==========================================
// PÔLE 02 : BRAND (Social, Content, Authority)
// ==========================================

model BrandCampaign {
  id          String   @id @default(cuid())
  name        String   // ex: "Lancement ProCall Office"
  objective   String
  status      String   @default("PLANNING") // PLANNING, ACTIVE, COMPLETED, PAUSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  drafts      ContentDraft[]

  @@index([status, createdAt])
}

model ContentDraft {
  id          String   @id @default(cuid())
  campaignId  String
  platform    String   // LINKEDIN, INSTAGRAM, TIKTOK
  format      String   // REEL, CAROUSEL, POST
  postText    String   @db.Text
  mediaUrls   Json?    // ["https://..."]
  status      String   @default("PENDING_GUARDIAN_APPROVAL") // PENDING_GUARDIAN_APPROVAL, PENDING_CEO_APPROVAL, APPROVED, REJECTED, PUBLISHED
  scheduledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign    BrandCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([status, createdAt])
}

model BrandMemory {
  id          String   @id @default(cuid())
  type        String   // TREND, POST_ANALYTICS, RULE
  content     String   @db.Text // "Les hooks courts marchent mieux en B2B"
  source      String?  // ID du post, ou "Google Trends"
  relevance   Int      @default(100) // Score de 0 à 100
  createdAt   DateTime @default(now())

  @@index([type])
}


// ==========================================
// AI NERVOUS SYSTEM (Agent Live State)
// ==========================================

model AgentActivity {
  id            String   @id @default(cuid())
  agentName     String   @unique // ex: "ChiefBrandAI"
  department    String   // ex: "02_BRAND"
  status        String   @default("IDLE") // IDLE, WORKING, ERROR
  currentTask   String?  // Description courte de l'action en cours
  lastLog       String?  @db.Text // Dernier log brut
  history       Json?    // Historique des 20 derni�res actions
  updatedAt     DateTime @updatedAt

  @@index([department])
  @@index([status])
}

