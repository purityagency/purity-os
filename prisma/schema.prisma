// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  passwordHash String?
  emailVerified DateTime? // preuve de propriété de la boîte mail (lien cliqué) — login CLIENT bloqué tant que null
  role      String    @default("CLIENT") // "ADMIN" or "CLIENT"
  createdAt DateTime  @default(now())

  projects  Project[]
  messages  Message[]
  magicLinkTokens MagicLinkToken[]

  @@index([role, createdAt])
  @@index([createdAt])
}

model MagicLinkToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  purpose    String   @default("PASSWORD_SET") // "PASSWORD_SET" ou "EMAIL_VERIFY" — un token n'est valable que pour l'usage prévu
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id               String     @id @default(cuid())
  clientId         String
  name             String
  status           String     @default("ACTIVE") // "ACTIVE", "COMPLETED", "ON_HOLD", "CANCELLED"
  estimatedDelivery DateTime?
  liveUrl          String?    // URL du site/outil livré une fois en ligne — affiche le CTA "Voir mon site" côté client
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // Origine commande (site public) — permet la vue financière réelle
  externalOrderId  String?    @unique // ex: ord_1234567890_abcdef (data/orders/*.json côté site)
  sector           String?    // coiffure, artisan, horeca, praticien...
  totalPrice       Float?     // prix total HTVA du pack/service
  depositAmount    Float?     // acompte encaissé (Mollie, one-shot)
  remainingAmount  Float?     // solde dû à la livraison (encaissé manuellement)
  monthlyAmount    Float?     // suivi mensuel récurrent

  client           User       @relation(fields: [clientId], references: [id])
  stages           Stage[]
  messages         Message[]
  documents        Document[]
  payments         Payment[]
  events           Event[]

  @@index([clientId])
  @@index([status, updatedAt])
  @@index([updatedAt])
}

model Stage {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      String    @default("PENDING") // "PENDING", "IN_PROGRESS", "WAITING_CLIENT", "BLOCKED", "REVIEW", "COMPLETED"
  orderIndex  Int
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id])
  messages    Message[]

  @@index([projectId, orderIndex])
  @@index([updatedAt])
}

model Message {
  id        String   @id @default(cuid())
  projectId String?
  stageId   String?
  authorId  String
  content   String
  createdAt DateTime @default(now())

  project   Project? @relation(fields: [projectId], references: [id])
  stage     Stage?   @relation(fields: [stageId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])

  @@index([projectId, createdAt])
  @@index([stageId])
  @@index([authorId])
}

model Document {
  id         String   @id @default(cuid())
  projectId  String
  type       String   // "INVOICE", "ASSET", "CONTRACT"
  url        String
  filename   String
  filesize   Int
  mimeType   String
  uploadedBy String
  uploadedAt DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id])

  @@index([projectId, uploadedAt])
  @@index([uploadedAt])
}

model Payment {
  id        String   @id @default(cuid())
  projectId String
  amount    Float
  status    String   @default("PENDING") // "PENDING", "PAID", "CANCELLED"
  type      String   // "DEPOSIT", "BALANCE", "QUOTE", "INVOICE", "PAYMENT"
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id])

  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

// Boîte de réception unifiée pour tout ce qui arrive du site public :
// question/lead (formulaire ou chatbot OctoMask), prise de RDV, commande payée.
// Les commandes créent aussi un Project (voir /api/internal/provision) — l'Event
// associé sert uniquement au fil d'activité, pas de duplication de données métier.
model Event {
  id        String    @id @default(cuid())
  type      String    // "LEAD", "BOOKING", "ORDER"
  status    String    @default("NEW") // "NEW", "SEEN", "DONE"
  name      String?
  email     String?
  phone     String?
  company   String?
  summary   String?   // ligne courte : besoin exprimé, pack commandé, créneau réservé...
  payload   Json?     // détail brut (need, entreprise, créneau, référence commande...)
  createdAt DateTime  @default(now())
  seenAt    DateTime?

  // Rattachement une fois la demande convertie en client/projet — permet de
  // remonter d'une fiche client vers la demande d'origine, et inversement.
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id])

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
  @@index([email])
  @@index([projectId])
}
