// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  passwordHash String?
  role      String    @default("CLIENT") // "ADMIN" or "CLIENT"
  createdAt DateTime  @default(now())
  
  projects  Project[]
  messages  Message[]
  magicLinkTokens MagicLinkToken[]
}

model MagicLinkToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id               String     @id @default(cuid())
  clientId         String
  name             String
  status           String     @default("ACTIVE") // "ACTIVE", "COMPLETED", "ON_HOLD", "CANCELLED"
  estimatedDelivery DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // Origine commande (site public) — permet la vue financière réelle
  externalOrderId  String?    @unique // ex: ord_1234567890_abcdef (data/orders/*.json côté site)
  sector           String?    // coiffure, artisan, horeca, praticien...
  totalPrice       Float?     // prix total HTVA du pack/service
  depositAmount    Float?     // acompte encaissé (Stripe, one-shot)
  remainingAmount  Float?     // solde dû à la livraison (hors Stripe, encaissé manuellement)
  monthlyAmount    Float?     // suivi mensuel récurrent (Stripe subscription)

  client           User       @relation(fields: [clientId], references: [id])
  stages           Stage[]
  messages         Message[]
  documents        Document[]
  payments         Payment[]
}

model Stage {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      String    @default("PENDING") // "PENDING", "IN_PROGRESS", "WAITING_CLIENT", "BLOCKED", "REVIEW", "COMPLETED"
  orderIndex  Int
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id])
  messages    Message[]
}

model Message {
  id        String   @id @default(cuid())
  projectId String?
  stageId   String?
  authorId  String
  content   String
  createdAt DateTime @default(now())

  project   Project? @relation(fields: [projectId], references: [id])
  stage     Stage?   @relation(fields: [stageId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])
}

model Document {
  id         String   @id @default(cuid())
  projectId  String
  type       String   // "INVOICE", "ASSET", "CONTRACT"
  url        String
  filename   String
  filesize   Int
  mimeType   String
  uploadedBy String
  uploadedAt DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id])
}

model Payment {
  id        String   @id @default(cuid())
  projectId String
  amount    Float
  status    String   @default("PENDING") // "PENDING", "PAID", "CANCELLED"
  type      String   // "QUOTE", "INVOICE", "PAYMENT"
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id])
}
